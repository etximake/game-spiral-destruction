{
  "$schema": "godot-mode-config-schema-v1",
  "meta": {
    "mode_id": "spiral",
    "name": "Spiral Destruction — Diamond Fireball Square",
    "version": "3.1",
    "description": "Fireball variant: fire sprite, square neon obstacles, diamond target emoji.",
    "scene_path": "res://Modes/SpiralDestruction/SpiralMode.tscn"
  },

  "content": {
    "variant_id": "diamond_fireball_square",
    "title": "CAN THE FIREBALL REACH THE DIAMOND?",
    "target_emoji": "\uD83D\uDC8E",
    "description": "A fiery ball tries to reach the diamond through square neon obstacles."
  },

  "viewport": {
    "resolution": [1080, 1920],
    "fullscreen": false,
    "background_color": "#000000",
    "camera_zoom": 0.9
  },

  "spiral": {
    "center": [540.0, 960.0],
    "gap_max": 110.0,
    "gap_min": 35.0,
    "turns": 7.0,
    "points_per_turn": 120,
    "stop_radius": 65.0,
    "line_width": 8.0,
    "line_color": [1.0, 1.0, 1.0, 0.8]
  },

  "triangles": {
    "shape": "square",
    "fill_style": "wall_attached",
    "angle_step_deg": 11.25,
    "side": 24.0,
    "gap_from_wall": 0.0,
    "collision_ratio": 0.25,
    "min_size": 5.0,
    "max_size": 100.0,
    "size_ratio": 0.8,
    "spacing_ratio": 1.15,
    "color_hue_start": 0.0,
    "color_hue_range": 1.3,
    "skip_at_spawn": 3,
    "skip_at_end": 2,
    "stop_distance_from_center": 80.0,
    "mesh": {
      "outer_brightness": 3.0,
      "inner_brightness": 0.4,
      "inner_alpha": 0.85,
      "hollow_scale": 0.65
    },
    "spawn_animation": {
      "wave_duration": 0.35,
      "scale_up_duration": 0.15,
      "regrow_duration": 0.5
    }
  },

  "ball": {
    "initial_radius": 42.0,
    "min_radius": 5.0,
    "base_speed": 900.0,
    "shrink_per_bounce": 1.5,
    "speed_escalation": {
      "min_multiplier": 1.5,
      "max_multiplier": 4.0
    },
    "trail_length": 5,
    "win_distance": 30.0,
    "color": [255, 100, 20],
    "visual_segments": 16,
    "spawn_offset": 20.0,
    "spawn_target_offset": 40.0,
    "visual": {
      "type": "sprite",
      "sprite_path": "res://Assets/BallSkins/fireball.png",
      "scale_to_radius": true,
      "rotation_enabled": true,
      "rotation_speed_multiplier": 1.5,
      "flip_with_velocity": false,
      "fallback_to_mesh": true
    },
    "glow": {
      "enabled": true,
      "radius_multiplier": 0.9,
      "color": [255, 60, 10],
      "alpha": 0.35,
      "pulse_speed": 2.5,
      "pulse_amplitude": 0.2
    }
  },

  "auto_test": {
    "enabled": true,
    "timeout": 20.0,
    "stuck_no_progress_seconds": 1.5,
    "out_of_bounds_delay": 1.5,
    "out_of_bounds_margin": 50.0,
    "out_of_bounds_radius_factor": 1.5,
    "transition": {
      "start_delay": 0.5,
      "flash_duration": 0.08,
      "flash_count": 4,
      "post_delay": 0.2
    },
    "tests": [
      { "radius": 32.0, "speed": 1000.0, "shrink": false },
      { "radius": 27.0, "speed": 1100.0, "shrink": false },
      { "radius": 22.0, "speed": 1200.0, "shrink": false },
      { "radius": 17.0, "speed": 1300.0, "shrink": false },
      { "radius": 10.0, "speed": 1400.0, "shrink": false }
    ]
  },

  "debris": {
    "pool_size": 64,
    "lifetime": 1.4,
    "gravity": 180.0,
    "num_shards": 4,
    "shard_sizes": [30.0, 50.0],
    "launch_speed": [400.0, 1000.0],
    "rotation_speed": [-20.0, 20.0],
    "num_burst_particles": 20
  },

  "win_effect": {
    "emoji": "\uD83D\uDC8E",
    "font_size": 100,
    "emoji_size": [200, 200],
    "celebration_emojis": ["\uD83D\uDC8E", "\u2B50", "\uD83D\uDD25", "\uD83C\uDF1F", "\uD83D\uDD2E"],
    "confetti_colors": [
      [1.0, 0.2, 0.1], [0.2, 1.0, 0.2], [1.0, 0.8, 0.0],
      [1.0, 0.4, 0.0], [1.0, 0.2, 0.5], [1.0, 1.0, 0.5], [1.0, 0.5, 0.0]
    ],
    "center_glow_burst": 10.0
  },

  "spatial_grid": {
    "cell_size": 100.0
  },

  "recording": {
    "enabled": true,
    "record_audio": true,
    "output_path": "res://recordings/spiral_diamond_fireball_square.mp4",
    "ffmpeg_path": "res://ffmpeg/bin/ffmpeg.exe",
    "fps": 60,
    "scale_factor": 1.0,
    "preset": "ultrafast",
    "crf": 23,
    "auto_start": true,
    "auto_stop": true,
    "verbose": true
  },

  "audio": {
    "pool_size": 16,
    "pitch_initial": 1.0,
    "pitch_increment": 0.04,
    "pitch_min": 0.8,
    "pitch_max": 2.5,
    "pitch_reset_delay": 1.0,
    "pitch_variation": 0.1,
    "bounce_sound_path": "res://Audio/dry-fart.mp3",
    "brick_sound_path": "res://Audio/glass-breaks-v1.mp3",
    "fail_sound_path": "res://Audio/error-sonido (mp3cut.net).mp3",
    "win_sound_path": "res://Audio/yeahoo.mp3",
    "win_sound_secondary_path": "res://Audio/anime-wow-sound-effect (mp3cut.net).mp3"
  },

  "hud": {
    "title": "CAN THE FIREBALL REACH THE DIAMOND?",
    "title_font_size": 64,
    "title_color": "#FF4400",
    "title_outline_color": "#FFFFFF",
    "title_outline_size": 20,
    "info_font_size": 32,
    "size_meter": {
      "position": [955, 130],
      "size": [24, 350],
      "radius_min": 15.0,
      "radius_max": 42.0,
      "border_width": 3
    },
    "spawn_line": {
      "position": [950, 450],
      "length": 50,
      "color": "#FFFFFF"
    }
  }
}
