{
  "$schema": "godot-mode-config-schema-v1",
  "meta": {
    "mode_id": "spiral",
    "name": "Spiral Destruction — Heart Coin Triangle",
    "version": "3.1",
    "description": "Coin variant: gold coin sprite, default triangle neon obstacles, heart target emoji.",
    "scene_path": "res://Modes/SpiralDestruction/SpiralMode.tscn"
  },

  "content": {
    "variant_id": "heart_coin_triangle",
    "title": "ONLY THE SMALLEST ONE GETS THE HEART",
    "target_emoji": "\u2764\uFE0F",
    "description": "A golden coin tries to reach the heart through triangular obstacles."
  },

  "viewport": {
    "resolution": [1080, 1920],
    "fullscreen": false,
    "background_color": "#000000",
    "camera_zoom": 0.9
  },

  "spiral": {
    "center": [540.0, 960.0],
    "gap_max": 110.0,
    "gap_min": 35.0,
    "turns": 7.0,
    "points_per_turn": 120,
    "stop_radius": 65.0,
    "line_width": 8.0,
    "line_color": [1.0, 1.0, 1.0, 0.8]
  },

  "triangles": {
    "shape": "triangle",
    "fill_style": "wall_attached",
    "angle_step_deg": 11.25,
    "side": 24.0,
    "gap_from_wall": 0.0,
    "collision_ratio": 0.25,
    "min_size": 5.0,
    "max_size": 100.0,
    "size_ratio": 0.8,
    "spacing_ratio": 1.15,
    "color_hue_start": 0.0,
    "color_hue_range": 0.8,
    "skip_at_spawn": 3,
    "skip_at_end": 2,
    "stop_distance_from_center": 80.0,
    "mesh": {
      "outer_brightness": 3.0,
      "inner_brightness": 0.5,
      "inner_alpha": 0.7,
      "hollow_scale": 0.6
    },
    "spawn_animation": {
      "wave_duration": 0.35,
      "scale_up_duration": 0.15,
      "regrow_duration": 0.5
    }
  },

  "ball": {
    "initial_radius": 35.0,
    "min_radius": 4.0,
    "base_speed": 700.0,
    "shrink_per_bounce": 1.2,
    "speed_escalation": {
      "min_multiplier": 1.5,
      "max_multiplier": 4.0
    },
    "trail_length": 3,
    "win_distance": 25.0,
    "color": [255, 215, 0],
    "visual_segments": 16,
    "spawn_offset": 20.0,
    "spawn_target_offset": 40.0,
    "visual": {
      "type": "sprite",
      "sprite_path": "res://Assets/BallSkins/coin.png",
      "scale_to_radius": true,
      "rotation_enabled": true,
      "rotation_speed_multiplier": 1.0,
      "flip_with_velocity": false,
      "fallback_to_mesh": true
    },
    "glow": {
      "enabled": true,
      "radius_multiplier": 1.0,
      "color": [255, 215, 0],
      "alpha": 0.3,
      "pulse_speed": 2.0,
      "pulse_amplitude": 0.15
    }
  },

  "auto_test": {
    "enabled": true,
    "timeout": 20.0,
    "stuck_no_progress_seconds": 1.5,
    "out_of_bounds_delay": 1.5,
    "out_of_bounds_margin": 50.0,
    "out_of_bounds_radius_factor": 1.5,
    "transition": {
      "start_delay": 0.5,
      "flash_duration": 0.08,
      "flash_count": 4,
      "post_delay": 0.2
    },
    "tests": [
      { "radius": 28.0, "speed": 750.0, "shrink": false },
      { "radius": 23.0, "speed": 820.0, "shrink": false },
      { "radius": 18.0, "speed": 900.0, "shrink": false },
      { "radius": 13.0, "speed": 1000.0, "shrink": false },
      { "radius": 7.0, "speed": 1100.0, "shrink": false }
    ]
  },

  "debris": {
    "pool_size": 64,
    "lifetime": 1.0,
    "gravity": 250.0,
    "num_shards": 3,
    "shard_sizes": [25.0, 45.0],
    "launch_speed": [300.0, 800.0],
    "rotation_speed": [-15.0, 15.0],
    "num_burst_particles": 18
  },

  "win_effect": {
    "emoji": "\u2764\uFE0F",
    "font_size": 100,
    "emoji_size": [200, 200],
    "celebration_emojis": ["\u2764\uFE0F", "\uD83D\uDC96", "\uD83D\uDC97", "\u2B50", "\uD83C\uDFC6"],
    "confetti_colors": [
      [1.0, 0.2, 0.2], [1.0, 0.6, 0.6], [1.0, 0.9, 0.0],
      [1.0, 0.4, 0.6], [0.8, 0.2, 0.5], [1.0, 0.7, 0.2], [0.2, 0.8, 1.0]
    ],
    "center_glow_burst": 9.0
  },

  "spatial_grid": {
    "cell_size": 100.0
  },

  "recording": {
    "enabled": true,
    "record_audio": true,
    "output_path": "res://recordings/spiral_heart_coin_triangle.mp4",
    "ffmpeg_path": "res://ffmpeg/bin/ffmpeg.exe",
    "fps": 60,
    "scale_factor": 1.0,
    "preset": "ultrafast",
    "crf": 23,
    "auto_start": true,
    "auto_stop": true,
    "verbose": true
  },

  "audio": {
    "pool_size": 16,
    "pitch_initial": 1.0,
    "pitch_increment": 0.03,
    "pitch_min": 0.8,
    "pitch_max": 2.5,
    "pitch_reset_delay": 1.0,
    "pitch_variation": 0.1,
    "bounce_sound_path": "res://Audio/dry-fart.mp3",
    "brick_sound_path": "res://Audio/glass-breaks-v1.mp3",
    "fail_sound_path": "res://Audio/error-sonido (mp3cut.net).mp3",
    "win_sound_path": "res://Audio/yeahoo.mp3",
    "win_sound_secondary_path": "res://Audio/anime-wow-sound-effect (mp3cut.net).mp3"
  },

  "hud": {
    "title": "ONLY THE SMALLEST ONE GETS THE HEART",
    "title_font_size": 64,
    "title_color": "#FF0033",
    "title_outline_color": "#FFFFFF",
    "title_outline_size": 20,
    "info_font_size": 32,
    "size_meter": {
      "position": [955, 130],
      "size": [24, 350],
      "radius_min": 10.0,
      "radius_max": 35.0,
      "border_width": 3
    },
    "spawn_line": {
      "position": [950, 450],
      "length": 50,
      "color": "#FFFFFF"
    }
  }
}
